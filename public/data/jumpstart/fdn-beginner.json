{"product":"Foundations Beginner Box","kind":"beginner","glossary":{"Enchant":"Found on Auras, it says what the Aura can be attached to (such as a creature or a land); if that thing leaves the battlefield, the Aura goes to the graveyard.","First strike":"This creature deals its combat damage before creatures without first strike, so it can often defeat an opponent before getting hit back.","Flying":"Can only be blocked by creatures with flying or reach.","Lifelink":"Damage dealt by this creature also makes you gain that much life.","Vigilance":"Attacking doesn't cause this creature to tap, so it can still block on your opponent's turn."},"cards":{"ea566679-4202-4076-9314-142241485f6e":{"n":"Ingenious Leonin","t":"Creature — Cat Soldier","c":5.0,"r":"uncommon"},"ff16d951-dd85-4d22-9505-ce6e2eaf47cf":{"n":"Bloodtithe Collector","t":"Creature — Vampire Noble","c":5.0,"r":"uncommon","kw":["Flying"]},"bd0c12dd-f138-45c0-9614-d83a1d8e8399":{"n":"Vengeful Bloodwitch","t":"Creature — Vampire Warlock","c":2.0,"r":"uncommon"},"03a5e19c-4cb8-4bd7-923c-4db747dc6ca3":{"n":"Crossway Troublemakers","t":"Creature — Vampire","c":6.0,"r":"rare"},"b405a442-cf6f-4c0b-9950-f208b30c052e":{"n":"Elspeth's Smite","t":"Instant","c":1.0,"r":"uncommon"},"485d6a5a-2054-47d5-91b8-71ce308ed4dc":{"n":"Stromkirk Bloodthief","t":"Creature — Vampire Rogue","c":3.0,"r":"uncommon"},"05937911-897b-4638-9536-2e463884f453":{"n":"Untamed Hunger","t":"Enchantment — Aura","c":3.0,"r":"common","kw":["Enchant"]},"53c56a23-eb4f-4be1-ada9-1ad5b80195d3":{"n":"Highborn Vampire","t":"Creature — Vampire Warrior","c":4.0,"r":"common"},"17b25850-f1bd-4410-beec-603b2a77f264":{"n":"Leonin Vanguard","t":"Creature — Cat Soldier","c":1.0,"r":"uncommon"},"cd092b14-d72f-4de0-8f19-1338661b9e3b":{"n":"Felidar Savior","t":"Creature — Cat Beast","c":4.0,"r":"common","kw":["Lifelink"]},"5aa8f635-c638-4207-8631-f6b5185f8696":{"n":"Jazal Goldmane","t":"Legendary Creature — Cat Warrior","c":4.0,"r":"rare","kw":["First strike"]},"135